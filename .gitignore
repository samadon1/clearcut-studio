# ==========================================
# CLEARCUT Root Git Ignore
# ==========================================

# --- Environment & Secret Variables ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# --- Python Virtual Environments & Build ---
venv/
.venv/
env/
ENV/
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# --- Node & Frontend Dependencies ---
frontend/node_modules/
node_modules/
frontend/.next/
.next/
frontend/out/
out/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Build Logs & Debugging ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Operating System & Editor Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.vercel
*.tsbuildinfo
